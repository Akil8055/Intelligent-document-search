# Application Environment Configuration Example
# Node.js API Service
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=25

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/docsearch
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR_LOCAL_PASSWORD
PGDATABASE=docsearch

# Python AI Service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=127.0.0.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ANSWER_MIN_RELEVANCE_SCORE=0.25
FAISS_INDEX_PATH=./services/ai/data/faiss_index.bin
FAISS_METADATA_PATH=./services/ai/data/faiss_metadata.json
REDIS_URL=redis://127.0.0.1:6379
